{
  "modules": ["./move-out.ts"],
  "hooks": {
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/notice.sh\" before", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/notice.sh\" prompt", "timeout": 5 }] }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/notice.sh\" after", "timeout": 5 }]
      }
    ]
  }
}
